# Copy this file to Key.env (same folder) and fill in the keys you have. Never commit Key.env.
# Several keys per provider may be given (..._KEY1, ..._KEY2, ...); later keys are used when one runs out of balance.

# DeepSeek (default profile)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# GPT-6.1-Sol (LLM_PROFILE=solrun or solhigh): any OpenAI-compatible endpoint serving the model
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6.1-sol

# Qwen3.8-Max and Qwen3.8-Flash (LLM_PROFILE=qwenmax, qwenflash): Alibaba Cloud Model Studio (DashScope)
DASHSCOPE_API_KEY=

# Doubao-Seed-2.1-Pro and -Lite (LLM_PROFILE=doubaopro, doubaolite): Volcano Engine Ark
ARK_API_KEY=
